# Production settings for docker-compose.prod.yml. Copy to infrastructure/.env.prod (git-ignored)
# and replace every value. Generate secrets with, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use hex (or other URL-safe) values: the passwords are embedded in connection URLs.

# Domain the site is served on; "localhost" uses a certificate from Caddy's local CA.
SITE_ADDRESS=localhost

MONGO_USER=stackforge
MONGO_PASSWORD=replace-with-a-random-hex-string
REDIS_PASSWORD=replace-with-a-random-hex-string
# At least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-hex-string-of-at-least-32-characters

# Google Gemini. Leave empty to run agents on rules only (advice is then unavailable).
LLM_API_KEY=

# Grafana admin password (Grafana listens on the server's localhost:3000 only).
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-hex-string

# Error tracking (optional): Sentry DSNs for the services and for the browser build.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Email for verification links and password-reset codes. Either:
#  - resend: a Resend API key and a sender on a domain verified in Resend; or
#  - smtp: e.g. Gmail with an App Password (no domain needed; about 500 emails a day). Set
#    SMTP_USER to the Gmail address, SMTP_PASSWORD to the App Password and EMAIL_FROM to
#    "Stack Forge <that address>".
# EMAIL_PROVIDER=none disables sending (users then cannot verify).
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Stack Forge <no-reply@your-domain.example>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Google sign-in: an OAuth 2.0 web client; its authorized redirect URI must be
# https://<SITE_ADDRESS>/api/v1/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM cost controls: tokens per user per UTC day (0 = no limit) and per turn.
LLM_USER_DAILY_TOKEN_QUOTA=200000
LLM_TURN_TOKEN_BUDGET=12000

# Backups: host folder for the dumps, how often, and how long to keep them.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Set by the deploy workflow; leave unset to build images locally.
# IMAGE_PREFIX=ghcr.io/<owner>/stackforge
# IMAGE_TAG=<commit sha>

