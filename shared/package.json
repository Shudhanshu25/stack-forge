{
  "name": "@stackforge/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JSON Schema contracts, industry templates and the types generated from them.",
  "exports": {
    ".": {
      "types": "./generated/ts/index.d.ts"
    },
    "./schemas/*": "./schemas/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.3"
  }
}
