{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "difficulty-modifiers.schema.json",
  "title": "DifficultyModifiers",
  "description": "Multipliers the engine applies to SimulationParameters for a difficulty level. 1.0 means unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cacMultiplier",
    "churnMultiplier",
    "conversionMultiplier",
    "competitorIntensityMultiplier",
    "eventProbabilityMultiplier",
    "negativeEventWeight"
  ],
  "properties": {
    "cacMultiplier": { "type": "number", "minimum": 0.1, "maximum": 5 },
    "churnMultiplier": { "type": "number", "minimum": 0.1, "maximum": 5 },
    "conversionMultiplier": { "type": "number", "minimum": 0.1, "maximum": 5 },
    "competitorIntensityMultiplier": { "type": "number", "minimum": 0.1, "maximum": 5 },
    "eventProbabilityMultiplier": { "type": "number", "minimum": 0, "maximum": 5 },
    "negativeEventWeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Relative weight of negative events against positive ones."
    }
  }
}
