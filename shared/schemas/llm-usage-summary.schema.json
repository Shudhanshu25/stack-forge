{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "llm-usage-summary.schema.json",
  "title": "LlmUsageSummary",
  "description": "The user's LLM token use today (UTC) against the daily quota.",
  "type": "object",
  "additionalProperties": false,
  "required": ["usedToday", "dailyQuota", "remaining", "exhausted", "resetsAt"],
  "properties": {
    "usedToday": {
      "type": "integer",
      "minimum": 0
    },
    "dailyQuota": {
      "type": "integer",
      "minimum": 0
    },
    "remaining": {
      "type": "integer",
      "minimum": 0
    },
    "exhausted": {
      "type": "boolean",
      "description": "Turns run in rules mode and the AI CEO is unavailable until the reset."
    },
    "resetsAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
