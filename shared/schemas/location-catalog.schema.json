{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "location-catalog.schema.json",
  "title": "LocationCatalog",
  "description": "States, their listed cities and the tiers, for choosing a startup's location.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataVersion", "country", "tiers", "states"],
  "properties": {
    "dataVersion": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "const": "IN"
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "label", "description"],
        "properties": {
          "tier": {
            "$ref": "enums.schema.json#/definitions/LocationTier"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "cities"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-2:IN state or union territory code, e.g. KA."
          },
          "name": {
            "type": "string"
          },
          "cities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "tier"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{2,40}$",
                  "description": "Id of a listed city, e.g. bengaluru."
                },
                "name": {
                  "type": "string"
                },
                "tier": {
                  "$ref": "enums.schema.json#/definitions/LocationTier"
                }
              }
            }
          }
        }
      }
    }
  }
}
