{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engine-preview-request.schema.json",
  "title": "EnginePreviewRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "decisions", "configuration", "seed", "turnNumber"],
  "properties": {
    "state": {
      "$ref": "simulation-state.schema.json"
    },
    "decisions": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "$ref": "decision.schema.json"
      }
    },
    "configuration": {
      "$ref": "startup-configuration.schema.json"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Seed for every random draw in the simulation. Stays within JavaScript's safe integer range."
    },
    "turnNumber": {
      "type": "integer",
      "minimum": 1
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Engine version the simulation was created with; it is computed by that version. Defaults to the current version."
    }
  }
}
