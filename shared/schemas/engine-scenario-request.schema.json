{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engine-scenario-request.schema.json",
  "title": "EngineScenarioRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "configuration", "seed", "horizon", "branches"],
  "properties": {
    "state": {
      "$ref": "simulation-state.schema.json"
    },
    "configuration": {
      "$ref": "startup-configuration.schema.json"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "horizon": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "branches": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "scenario-branch-input.schema.json"
      }
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Engine version the simulation was created with; it is computed by that version. Defaults to the current version."
    }
  }
}
