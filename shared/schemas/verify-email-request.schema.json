{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verify-email-request.schema.json",
  "title": "VerifyEmailRequest",
  "description": "The token from the verification link.",
  "type": "object",
  "additionalProperties": false,
  "required": ["token"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
