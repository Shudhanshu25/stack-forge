{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "account-delete-request.schema.json",
  "title": "AccountDeleteRequest",
  "description": "Permanently delete the account and all its data. `password` is required when the account has one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirm"],
  "properties": {
    "confirm": {
      "type": "string",
      "const": "DELETE MY ACCOUNT"
    },
    "password": {
      "type": "string",
      "maxLength": 128
    }
  }
}
