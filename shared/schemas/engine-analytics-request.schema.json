{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engine-analytics-request.schema.json",
  "title": "EngineAnalyticsRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["initialState", "records", "seed", "configuration"],
  "properties": {
    "initialState": {
      "$ref": "simulation-state.schema.json"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "simulation-turn.schema.json"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "configuration": {
      "$ref": "startup-configuration.schema.json"
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Engine version the simulation was created with; it is computed by that version. Defaults to the current version."
    }
  }
}
