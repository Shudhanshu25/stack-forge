{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engine-start-request.schema.json",
  "title": "EngineStartRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["configuration", "seed"],
  "properties": {
    "configuration": {
      "$ref": "startup-configuration.schema.json"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Seed for every random draw in the simulation. Stays within JavaScript's safe integer range."
    }
  }
}
