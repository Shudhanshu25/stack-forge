{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event-catalog.schema.json",
  "title": "EventCatalog",
  "description": "Shape of shared/templates/events.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventsVersion", "events"],
  "properties": {
    "eventsVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "market-event.schema.json"
      }
    }
  }
}
