{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "simulation.schema.json",
  "title": "Simulation",
  "description": "A simulation of one startup. The configuration is snapshotted when it starts. currentState is the stateAfter of the latest turn, or the initial state before turn 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ownerId",
    "startupId",
    "seed",
    "agentMode",
    "status",
    "engineVersion",
    "currentTurn",
    "configuration",
    "currentState",
    "activeJobId",
    "createdAt",
    "updatedAt",
    "startupName",
    "productName"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "startupId": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Seed for every random draw in the simulation. Stays within JavaScript's safe integer range."
    },
    "agentMode": {
      "$ref": "enums.schema.json#/definitions/AgentMode"
    },
    "status": {
      "$ref": "enums.schema.json#/definitions/SimulationStatus"
    },
    "engineVersion": {
      "type": "string",
      "description": "Engine version that created the initial state."
    },
    "currentTurn": {
      "type": "integer",
      "minimum": 0
    },
    "configuration": {
      "$ref": "startup-configuration.schema.json"
    },
    "currentState": {
      "$ref": "simulation-state.schema.json"
    },
    "activeJobId": {
      "type": ["string", "null"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "startupName": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    }
  }
}
