  "$id": "difficulty-presets.schema.json",
  "title": "DifficultyPresets",
  "description": "Shape of shared/templates/difficulty.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["EASY", "NORMAL", "HARD"],
