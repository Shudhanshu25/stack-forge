{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decisions-request.schema.json",
  "title": "DecisionsRequest",
  "description": "Body of preview and turn requests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "$ref": "decision.schema.json"
      }
    }
  }
}
