{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "password-reset-verify-response.schema.json",
  "title": "PasswordResetVerifyResponse",
  "description": "The code was right: a single-use token for POST /auth/password-reset/confirm.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resetToken", "expiresInSeconds"],
  "properties": {
    "resetToken": {
      "type": "string",
      "minLength": 20,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "expiresInSeconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}
