# Backend API (Node/Express). Copy to backend/.env for local development.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017/stackforge
REDIS_URL=redis://localhost:6379
SIMULATION_URL=http://127.0.0.1:8000

# Origin of the React app; CORS allows only this origin.
CORS_ORIGIN=http://localhost:5173

# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Defaults to true when NODE_ENV=production. Must be true when served over HTTPS.
COOKIE_SECURE=false
# Path of the refresh cookie as the browser sees it.
COOKIE_PATH=/api/v1/auth

# Requests per 15 minutes per IP on /api/v1/auth routes.
AUTH_RATE_LIMIT_MAX=20
BODY_LIMIT=100kb
# Set to the number of reverse proxies in front of the API (0 in development).
TRUST_PROXY=0

# Simulation service calls: preview/start/replay, and the whole turn pipeline.
ENGINE_TIMEOUT_MS=15000
PIPELINE_TIMEOUT_MS=60000
# Turn jobs the worker (npm run worker) processes in parallel.
WORKER_CONCURRENCY=4

# Observability (all optional). Sentry error tracking; OpenTelemetry traces to an OTLP/HTTP
# collector such as Tempo; the worker serves Prometheus metrics on WORKER_METRICS_PORT.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
WORKER_METRICS_PORT=9464

# Public URL of the web app (links in emails, return address after Google sign-in).
APP_URL=http://localhost:5173
# Email: outbox (development: writes each email to OUTBOX_DIR as an HTML file), smtp (real
# delivery, e.g. Gmail), resend, or none.
EMAIL_PROVIDER=outbox
OUTBOX_DIR=.outbox
EMAIL_API_KEY=
EMAIL_FROM=Stack Forge <no-reply@localhost>
# Gmail (EMAIL_PROVIDER=smtp): turn on 2-step verification for the Gmail account, create an App
# Password at https://myaccount.google.com/apppasswords, then set SMTP_USER to the Gmail address,
# SMTP_PASSWORD to the 16-character App Password, and EMAIL_FROM to "Stack Forge <that address>".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_VERIFICATION_TTL_HOURS=24
# Forgot password: a 6-digit code is emailed (valid this many minutes); once accepted, the new
# password must be set within PASSWORD_RESET_TTL_MINUTES.
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=30
# Google sign-in (off when empty). Authorized redirect URI in the Google console must match.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# LLM tokens a user may spend per UTC day (0 = no limit); after that turns run in rules mode.
LLM_USER_DAILY_TOKEN_QUOTA=200000
