# Frontend (Vite). Copy to frontend/.env for local development.
# Base URL of the Node API. Must match an origin the API's CORS_ORIGIN allows this app from.
VITE_API_URL=http://localhost:4000/api/v1
# WebSocket URL, only when the API's proxy cannot carry WebSockets (Vercel): wss://<api host>/api/v1/ws
VITE_WS_URL=

# Error tracking (optional): Sentry DSN for the browser and the release (commit SHA).
VITE_SENTRY_DSN=
VITE_RELEASE_SHA=
