# Simulation service (FastAPI). Copy to simulation/.env for local development.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=10000000

# LLM: Google Gemini. Without a key, llm-mode agents fall back to rules and advice is unavailable.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_AGENT_MODEL=gemini-3.5-flash-lite
LLM_ADVISOR_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=10
# Per-turn caps on agent modifiers (values outside [-1, 1] are rejected outright).
AGENT_DEMAND_CAP=0.15
AGENT_SENTIMENT_CAP=0.1
ADVISOR_ON_TURN=true
# Defaults to simulation/ml/artifacts (train with: python -m ml.train)
# FORECAST_MODEL_DIR=

# Observability (all optional): Sentry error tracking and OpenTelemetry traces (OTLP/HTTP).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# LLM cost controls: tokens one turn may spend (0 = no limit) and the agent cache (Redis URL;
# empty disables it) with its entry lifetime. Pin a prompt version with PROMPT_VERSION_<NAME>=1.
LLM_TURN_TOKEN_BUDGET=12000
REDIS_URL=
AGENT_CACHE_TTL_S=604800
